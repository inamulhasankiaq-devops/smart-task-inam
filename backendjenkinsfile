pipeline {

    agent any

    environment {

        GIT_REPO = 'https://github.com/inamulhasankiaq-devops/smart-task-inam.git'
        GIT_BRANCH = 'main'

        HARBOR_REGISTRY = 'localhost:80'

        HARBOR_PROJECT = 'smart-task'

        IMAGE_TAG = "${BUILD_NUMBER}"

        K8S_NAMESPACE = 'smart-task'
    }


    stages {



        stage('Checkout') {

            steps {

                echo '========================================'
                echo 'Checking out Smart Task repository'
                echo '========================================'

                git branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO}"
            }
        }


        // 2. INSTALL BACKEND DEPENDENCIES

        stage('Install Dependencies') {

            parallel {


                stage('Install Auth Service') {

                    steps {

                        dir('auth-service_1784011000189') {

                            sh '''
                                echo "Installing Auth Service dependencies..."
                                npm ci
                            '''
                        }
                    }
                }


                stage('Install Task Service') {

                    steps {

                        dir('task-service') {

                            sh '''
                                echo "Installing Task Service dependencies..."
                                npm ci
                            '''
                        }
                    }
                }


                stage('Install Notification Service') {

                    steps {

                        dir('notification-service') {

                            sh '''
                                echo "Installing Notification Service dependencies..."
                                npm ci
                            '''
                        }
                    }
                }


                stage('Install Report Service') {

                    steps {

                        dir('report-service') {

                            sh '''
                                echo "Installing Report Service dependencies..."
                                npm ci
                            '''
                        }
                    }
                }


                stage('Install API Gateway') {

                    steps {

                        dir('api-gateway_1784010924579') {

                            sh '''
                                echo "Installing API Gateway dependencies..."
                                npm ci
                            '''
                        }
                    }
                }
            }
        }


    stage('SonarQube') {
    steps {
        script {
            def scannerHome = tool 'SonarScanner'

            withCredentials([
                string(
                    credentialsId: 'sonar-token',
                    variable: 'SONAR_TOKEN'
                )
            ]) {
                withSonarQubeEnv('SonarQube') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=frontend-sonar \
                        -Dsonar.projectName=frontend-sonar \
                        -Dsonar.sources=. \
                        -Dsonar.exclusions=**/node_modules/**,**/.dist/**,**/build/** \
                        -Dsonar.host.url=http://localhost:9000 \
                        -Dsonar.token=\$SONAR_TOKEN
                    """
                }
           }
        }
    }
}

        stage('Quality Gate') {

            steps {

                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true
                }
            }
        }


         stage('Build Docker Images') {

            parallel {

                stage('Auth Docker Image') {

                    steps {

                        sh """
                            docker build \
                            -t ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/auth-service:${IMAGE_TAG} \
                            ./auth-service_1784011000189
                        """
                    }
                }


                stage('Task Docker Image') {

                    steps {

                        sh """
                            docker build \
                            -t ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/task-service:${IMAGE_TAG} \
                            ./task-service
                        """
                    }
                }


                stage('Report Docker Image') {

                    steps {

                        sh """
                            docker build \
                            -t ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/report-service:${IMAGE_TAG} \
                            ./report-service
                        """
                    }
                }


                stage('Notification Docker Image') {

                    steps {

                        sh """
                            docker build \
                            -t ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/notification-service:${IMAGE_TAG} \
                            ./notification-service
                        """
                    }
                }


                stage('API Gateway Docker Image') {

                    steps {

                        sh """
                            docker build \
                            -t ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/api-gateway:${IMAGE_TAG} \
                            ./api-gateway_1784010924579
                        """
                    }
                }
            }
        }


// =====================================================
        stage('Login to Harbor') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'harbor-credentials',
                        usernameVariable: 'HARBOR_USERNAME',
                        passwordVariable: 'HARBOR_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$HARBOR_PASSWORD" | docker login \
                        "$HARBOR_REGISTRY" \
                        -u "$HARBOR_USERNAME" \
                        --password-stdin
                    '''
                }
            }
        }

        // =====================================================
        stage('Push Images to Harbor') {

            steps {

                sh '''

                    docker push \
                    $HARBOR_REGISTRY/$HARBOR_PROJECT/auth-service:$IMAGE_TAG

                    docker push \
                    $HARBOR_REGISTRY/$HARBOR_PROJECT/task-service:$IMAGE_TAG

                    docker push \
                    $HARBOR_REGISTRY/$HARBOR_PROJECT/report-service:$IMAGE_TAG

                    docker push \
                    $HARBOR_REGISTRY/$HARBOR_PROJECT/notification-service:$IMAGE_TAG

                    docker push \
                    $HARBOR_REGISTRY/$HARBOR_PROJECT/api-gateway:$IMAGE_TAG
                '''
            }
        }

        stage('Deploy Backend to Kubernetes') {

            steps {

                sh '''

                    echo "Updating Kubernetes deployments..."

                    kubectl -n $K8S_NAMESPACE set image \
                    deployment/auth-service \
                    auth-service=$HARBOR_REGISTRY/$HARBOR_PROJECT/auth-service:$IMAGE_TAG

                    kubectl -n $K8S_NAMESPACE set image \
                    deployment/task-service \
                    task-service=$HARBOR_REGISTRY/$HARBOR_PROJECT/task-service:$IMAGE_TAG

                    kubectl -n $K8S_NAMESPACE set image \
                    deployment/report-service \
                    report-service=$HARBOR_REGISTRY/$HARBOR_PROJECT/report-service:$IMAGE_TAG

                    kubectl -n $K8S_NAMESPACE set image \
                    deployment/notification-service \
                    notification-service=$HARBOR_REGISTRY/$HARBOR_PROJECT/notification-service:$IMAGE_TAG

                    kubectl -n $K8S_NAMESPACE set image \
                    deployment/api-gateway \
                    api-gateway=$HARBOR_REGISTRY/$HARBOR_PROJECT/api-gateway:$IMAGE_TAG
                '''
            }
        }

        stage('Verify Deployment') {

            steps {

                sh '''

                    kubectl -n $K8S_NAMESPACE rollout status \
                    deployment/auth-service \
                    --timeout=180s

                    kubectl -n $K8S_NAMESPACE rollout status \
                    deployment/task-service \
                    --timeout=180s

                    kubectl -n $K8S_NAMESPACE rollout status \
                    deployment/report-service \
                    --timeout=180s

                    kubectl -n $K8S_NAMESPACE rollout status \
                    deployment/notification-service \
                    --timeout=180s

                    kubectl -n $K8S_NAMESPACE rollout status \
                    deployment/api-gateway \
                    --timeout=180s
                '''
            }
        }

        stage('Check Kubernetes Pods') {

            steps {

                sh '''
                    kubectl get pods -n $K8S_NAMESPACE
                    kubectl get svc -n $K8S_NAMESPACE
                '''
            }
        }
    }


    }
}
