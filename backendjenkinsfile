pipeline {

    agent any

    environment {

        GIT_REPO = 'https://github.com/inamulhasankiaq-devops/smart-task-inam.git'
        GIT_BRANCH = 'main'

        EC2_HOST = '3.110.46.199'
        EC2_USER = 'ubuntu'
        EC2_APP_DIR = '/home/ubuntu/smart-task-inam'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        // =====================================================
        // 1. CHECKOUT
        // =====================================================

        stage('Checkout') {

            steps {

                echo '========================================'
                echo 'Checking out backend repository'
                echo '========================================'

                git branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO}"
            }
        }


        // =====================================================
        // 2. INSTALL DEPENDENCIES
        // =====================================================

        stage('Install Dependencies') {

            parallel {

                stage('Auth Service') {

                    steps {

                        dir('auth-service_1784011000189') {

                            sh '''
                                echo "Installing Auth Service dependencies..."
                                npm ci
                            '''
                        }
                    }
                }


                stage('Task Service') {

                    steps {

                        dir('task-service') {

                            sh '''
                                echo "Installing Task Service dependencies..."
                                npm ci
                            '''
                        }
                    }
                }


                stage('Notification Service') {

                    steps {

                        dir('notification-service') {

                            sh '''
                                echo "Installing Notification Service dependencies..."
                                npm ci
                            '''
                        }
                    }
                }


                stage('Report Service') {

                    steps {

                        dir('report-service') {

                            sh '''
                                echo "Installing Report Service dependencies..."
                                npm ci
                            '''
                        }
                    }
                }


                stage('API Gateway') {

                    steps {

                        dir('api-gateway_1784010924579') {

                            sh '''
                                echo "Installing API Gateway dependencies..."
                                npm ci
                            '''
                        }
                    }
                }
            }
        }


        // =====================================================
        // 3. SONARQUBE SCAN
        // =====================================================

            stage('SonarQube') {
                steps {
                    script {
                        def scannerHome = tool 'SonarScanner'
            
                        withCredentials([
                            string(
                                credentialsId: 'sonar-token',
                                variable: 'SONAR_TOKEN'
                            )
                        ]) {
                            withSonarQubeEnv('SonarQube') {
                                sh """
                                    ${scannerHome}/bin/sonar-scanner \
                                    -Dsonar.projectKey=frontend-sonar \
                                    -Dsonar.projectName=frontend-sonar \
                                    -Dsonar.sources=. \
                                    -Dsonar.exclusions=**/node_modules/**,**/.dist/**,**/build/** \
                                    -Dsonar.host.url=http://localhost:9000 \
                                    -Dsonar.token=\$SONAR_TOKEN
                                """
                            }
                       }
                    }
                }
            }



        // =====================================================
        // 4. QUALITY GATE
        // =====================================================

        stage('Quality Gate') {

            steps {

                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true
                }
            }
        }


        // =====================================================
        // 5. CONNECT TO EC2
        // =====================================================

        stage('Deploy to EC2') {

            steps {

                echo '========================================'
                echo 'Connecting to EC2'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """

                        ssh -o StrictHostKeyChecking=no \
                        ${EC2_USER}@${EC2_HOST} '

                            set -e

                            echo "Connected to EC2 successfully"

                            cd ${EC2_APP_DIR}

                            echo "Current directory:"
                            pwd

                            echo "========================================"
                            echo "Pulling latest code"
                            echo "========================================"

                            git fetch origin ${GIT_BRANCH}
                            git reset --hard origin/${GIT_BRANCH}

                            echo "Latest code pulled successfully"

                        '
                    """
                }
            }
        }


        // =====================================================
        // 6. BUILD DOCKER IMAGE ON EC2
        // =====================================================

        stage('Build Docker Image') {

            steps {

                echo '========================================'
                echo 'Building Docker image on EC2'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """

                        ssh -o StrictHostKeyChecking=no \
                        ${EC2_USER}@${EC2_HOST} '

                            set -e

                            cd ${EC2_APP_DIR}

                            echo "Building Docker images..."

                            docker compose build

                            echo "Docker build completed successfully"

                        '
                    """
                }
            }
        }


        // =====================================================
        // 7. DOCKER COMPOSE UP
        // =====================================================

        stage('Compose Up') {

            steps {

                echo '========================================'
                echo 'Starting backend services'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """

                        ssh -o StrictHostKeyChecking=no \
                        ${EC2_USER}@${EC2_HOST} '

                            set -e

                            cd ${EC2_APP_DIR}

                            echo "Stopping old containers..."

                            docker compose down

                            echo "Starting new containers..."

                            docker compose up -d

                            echo "Backend services started"

                        '
                    """
                }
            }
        }


        // =====================================================
        // 8. VERIFY DEPLOYMENT
        // =====================================================

        stage('Verify') {

            steps {

                echo '========================================'
                echo 'Verifying deployment'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """

                        ssh -o StrictHostKeyChecking=no \
                        ${EC2_USER}@${EC2_HOST} '

                            set -e

                            cd ${EC2_APP_DIR}

                            echo "========================================"
                            echo "Docker Compose Status"
                            echo "========================================"

                            docker compose ps

                            echo "========================================"
                            echo "Running Containers"
                            echo "========================================"

                            docker ps

                            echo "Deployment verification completed"

                        '
                    """
                }
            }
        }
    }


    // =========================================================
    // POST ACTIONS
    // =========================================================

    post {

        success {

            echo '''
            ========================================
              BACKEND DEPLOYMENT SUCCESSFUL
            ========================================
            '''

            echo "Build Number: ${BUILD_NUMBER}"
            echo "Backend deployed successfully to EC2."
        }


        failure {

            echo '''
            ========================================
              BACKEND DEPLOYMENT FAILED
            ========================================
            '''

            echo "Build Number: ${BUILD_NUMBER}"
            echo "Check Jenkins console output for details."
        }


        always {

            echo '========================================'
            echo 'Jenkins pipeline completed'
            echo '========================================'
        }
    }
}
